---
import { site } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import FadeIn from './motion/FadeIn.tsx';

// Famílias sem página própria. soap-grpc-bridge e vbnet-strangler-fig aparecem nos dois:
// card sticky → página interna; aqui → repositório no GitHub.
const featured = ['jobforge', 'logpipe', 'einvoice'];
type Repo = { name: string; url: string; text: string };
type Family = { name: string; repos: Repo[] };
const families: Family[] = site.cv.families
  .filter((f) => !featured.includes(f.name))
  .map((f) => ({ name: f.name, repos: [...f.repos] }));
// a família maior ocupa a largura toda e vem primeiro; as demais fecham as colunas
const widest = Math.max(...families.map((f) => f.repos.length));
const ordered = [...families].sort((a, b) => b.repos.length - a.repos.length);
const humanTitle = (slug: string) =>
  slug.split('-').join(' ').replace(/\b\w/g, (c) => c.toUpperCase());
---

<section id="outros" class="relative z-10 px-5 pb-24 sm:px-8 md:px-10">
  <FadeIn y={30}><SectionHeading text="Outros repositórios" /></FadeIn>
  <FadeIn delay={0.1}>
    <p class="mx-auto mt-6 max-w-[560px] text-center font-light leading-relaxed text-[var(--fg)]/70">
      Plataforma, estudos de arquitetura e web — cada um com README, testes e CI próprios.
    </p>
  </FadeIn>
  {families.length > 0 && (
  <div class="mx-auto mt-10 grid max-w-6xl gap-x-4 gap-y-8 sm:grid-cols-2">
    {ordered.map((f, fi) => (
      <div class={f.repos.length === widest ? 'sm:col-span-2' : ''}>
        <FadeIn delay={0.05 * fi}>
          <p class="text-xs uppercase tracking-widest text-[var(--fg)]/60">{f.name}</p>
        </FadeIn>
        <div class={`mt-3 grid gap-4 ${f.repos.length === widest ? 'sm:grid-cols-2' : ''}`}>
          {f.repos.map((r, i) => (
            <FadeIn delay={0.05 * i}>
              <a href={r.url} target="_blank" rel="noopener noreferrer"
                class="flex h-full flex-col rounded-[var(--radius-tile)] border border-[var(--fg)]/20 p-5 transition-colors duration-200 hover:border-[var(--fg)]/60">
                <h3 class="font-medium text-[var(--fg)]">{humanTitle(r.name)}</h3>
                <p class="mt-1 font-mono text-[11px] text-[var(--fg)]/60">{r.name}</p>
                <p class="mt-2 font-light leading-relaxed text-[var(--fg)]/65" style="font-size:clamp(.85rem, 1.4vw, 1rem)">{r.text}</p>
              </a>
            </FadeIn>
          ))}
        </div>
      </div>
    ))}
  </div>
  )}
</section>
