---
interface Props { href: string; label?: string; external?: boolean }
const { href, label = 'Ver projeto', external = false } = Astro.props;
---
<a href={href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border-2 border-[var(--fg)] px-8 py-3 text-sm font-medium uppercase tracking-widest text-[var(--fg)] transition-colors duration-200 hover:bg-[#D7E2EA]/10 sm:px-10 sm:py-3.5 sm:text-base">
  {label}
</a>
