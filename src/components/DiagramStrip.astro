---
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({ slug: p.id, title: p.data.title, summary: p.data.summary, diagram: p.data.diagram }));
---
<section aria-labelledby="sistemas" class="relative z-10 px-5 pb-16 pt-24 sm:px-8 sm:pt-32 md:px-10 md:pt-40">
  <h2 id="sistemas" class="sr-only">Sistemas</h2>
  <p class="mx-auto max-w-[560px] text-center text-xs font-light uppercase tracking-widest text-[var(--fg)]/60">
    {projects.length} sistemas · arquitetura de cada um
  </p>
  <ul class="mx-auto mt-8 grid max-w-6xl gap-x-4 gap-y-8 md:grid-cols-2">
    {projects.map((p, i) => (
      <li>
        <a href={`/projetos/${p.slug}`} class="group flex h-full flex-col rounded-[var(--radius-tile)] border border-[var(--fg)]/15 p-3 transition-colors duration-200 hover:border-[var(--fg)]/50">
          <img src={p.diagram} alt={`Diagrama de arquitetura do ${p.title}`} width={1200} height={205} loading="lazy" decoding="async"
            class="w-full rounded-[calc(var(--radius-tile)-4px)]" />
          <span class="mt-3 flex items-baseline gap-2 text-xs uppercase tracking-widest text-[var(--fg)]">
            <span class="font-mono text-[var(--fg)]/60">{String(i + 1).padStart(2, '0')}</span>{p.title}
          </span>
          <span class="mt-1 font-light leading-relaxed text-[var(--fg)]/60" style="font-size:clamp(.8rem, 1.3vw, .95rem)">{p.summary}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
