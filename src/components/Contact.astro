---
import { site } from '../content/site';
import ContactButton from './ContactButton.astro';
import SectionHeading from './SectionHeading.astro';
import FadeIn from './motion/FadeIn.tsx';

const wa = site.whatsapp ? `https://wa.me/${site.whatsapp}` : null;
---
<section id="contato" class="relative z-10 flex flex-col items-center gap-10 px-5 pb-10 pt-20 text-center sm:px-8 sm:pt-28 md:gap-14 md:px-10 md:pt-36">
  <FadeIn y={40}><SectionHeading text="Contato" /></FadeIn>
  <FadeIn delay={0.15}>
    <p class="max-w-[560px] font-medium leading-relaxed text-[var(--fg)]" style="font-size:clamp(1rem, 2vw, 1.35rem)">
      A próxima entrega pode ser a sua. Me conte o que você precisa e o prazo que tem em mente.
    </p>
  </FadeIn>
  <FadeIn delay={0.3}><ContactButton label="Escrever e-mail" href={`mailto:${site.email}`} /></FadeIn>
  <FadeIn delay={0.4} className="flex flex-wrap justify-center gap-x-8 gap-y-4 text-sm text-[var(--fg)] sm:text-base">
    <a class="font-medium tracking-wide transition-opacity hover:opacity-70" href={`mailto:${site.email}`}>{site.email}</a>
    <a class="font-medium tracking-wide transition-opacity hover:opacity-70" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    {site.linkedin && <a class="font-medium tracking-wide transition-opacity hover:opacity-70" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>}
    {wa && <a class="font-medium tracking-wide transition-opacity hover:opacity-70" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp</a>}
  </FadeIn>
</section>
