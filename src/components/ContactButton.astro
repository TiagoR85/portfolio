---
interface Props { href?: string; label?: string }
const { href = '#contato', label = 'Fale comigo' } = Astro.props;
---
<a href={href}
  class="cta-pill inline-block whitespace-nowrap rounded-full px-8 py-3 text-xs font-medium uppercase tracking-widest text-white transition-transform duration-200 hover:-translate-y-0.5 sm:px-10 sm:py-3.5 sm:text-sm md:px-12 md:py-4 md:text-base">
  {label}
</a>
