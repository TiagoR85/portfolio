---
import Layout from '../layouts/Layout.astro';
import { site } from '../content/site';

const { cv } = site;
const contact = [
  { label: site.email, href: `mailto:${site.email}` },
  { label: 'github.com/TiagoR85', href: site.github },
  { label: 'LinkedIn', href: site.linkedin },
];
---
<Layout title={`CV — ${site.name}`} description={`Curriculum de ${site.name}: ${site.role}. Experiência, formação, idiomas e projetos.`} ogImage="/og/cv.png">
  <main id="conteudo" class="mx-auto max-w-4xl px-5 py-12 text-[var(--fg)] sm:px-8 print:py-0">
    <div class="mb-10 flex flex-wrap items-center justify-between gap-4 print:hidden">
      <a href="/" class="text-sm uppercase tracking-widest text-[var(--fg)]/60 hover:text-[var(--fg)]">← Início</a>
      <button type="button" class="rounded-full border-2 border-[var(--fg)] px-6 py-2 text-sm font-medium uppercase tracking-widest hover:bg-[var(--fg)]/10"
        onclick="window.print()">Imprimir / salvar PDF</button>
    </div>

    <header class="flex flex-col gap-3">
      <h1 class="hero-heading font-black uppercase leading-none print:text-black" style="font-size:clamp(2.4rem, 8vw, 96px)">{site.name}</h1>
      <p class="font-light uppercase tracking-widest text-[var(--fg)]/70">{site.role}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-[var(--fg)]/70">
        {contact.map((c) => <li><a class="underline decoration-[var(--fg)]/30 hover:opacity-70" href={c.href}>{c.label}</a></li>)}
        <li>São José — SC, Brasil</li>
      </ul>
      <p class="text-sm font-light text-[var(--fg)]/70">{cv.availability}</p>
      <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
        {site.proof.map((p) => (
          <li class="flex items-baseline gap-1.5">
            <span class="font-black">{p.value}</span>
            <span class="text-xs font-light uppercase tracking-wide text-[var(--fg)]/60">{p.label}</span>
          </li>
        ))}
      </ul>
    </header>

    <section class="mt-12" aria-labelledby="perfil">
      <h2 id="perfil" class="text-lg font-medium uppercase tracking-widest">Perfil</h2>
      <div class="mt-3 flex flex-col gap-3 font-light leading-relaxed text-[var(--fg)]/85">
        {cv.profile.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="mt-12" aria-labelledby="experiencia">
      <h2 id="experiencia" class="text-lg font-medium uppercase tracking-widest">Experiência</h2>
      <ol class="mt-4 flex flex-col gap-6">
        {cv.experience.map((e) => (
          <li class="grid gap-1 border-t border-[var(--fg)]/15 pt-5 sm:grid-cols-[150px_1fr] sm:gap-6 print:break-inside-avoid">
            <p class="font-mono text-xs uppercase tracking-wider text-[var(--fg)]/60">{e.period}</p>
            <div class="flex flex-col gap-1">
              <h3 class="font-medium text-[var(--fg)]">{e.role}</h3>
              <p class="text-sm font-light text-[var(--fg)]/70">{e.company} · {e.place}</p>
              <ul class="mt-2 flex list-disc flex-col gap-1 pl-5 font-light leading-relaxed text-[var(--fg)]/80">
                {e.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-12" aria-labelledby="formacao">
      <h2 id="formacao" class="text-lg font-medium uppercase tracking-widest">Formação</h2>
      <ul class="mt-4 flex flex-col gap-4">
        {cv.education.map((ed) => (
          <li class="grid gap-1 border-t border-[var(--fg)]/15 pt-5 sm:grid-cols-[150px_1fr] sm:gap-6 print:break-inside-avoid">
            <p class="font-mono text-xs uppercase tracking-wider text-[var(--fg)]/60">{ed.period}</p>
            <div>
              <h3 class="font-medium text-[var(--fg)]">{ed.course}</h3>
              <p class="text-sm font-light text-[var(--fg)]/70">{ed.institution} · {ed.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <div class="mt-12 grid gap-10 sm:grid-cols-2 print:break-inside-avoid">
      <section aria-labelledby="idiomas">
        <h2 id="idiomas" class="text-lg font-medium uppercase tracking-widest">Idiomas</h2>
        <ul class="mt-3 flex flex-col gap-1 font-light text-[var(--fg)]/85">
          {cv.languages.map((l) => <li><span class="font-medium text-[var(--fg)]">{l.name}</span> — {l.level}</li>)}
        </ul>
      </section>
      <section aria-labelledby="certificacoes">
        <h2 id="certificacoes" class="text-lg font-medium uppercase tracking-widest">Certificações</h2>
        <ul class="mt-3 flex list-disc flex-col gap-1 pl-5 font-light text-[var(--fg)]/85">
          {cv.certifications.map((c) => <li>{c}</li>)}
        </ul>
      </section>
    </div>

    <section class="mt-12" aria-labelledby="competencias">
      <h2 id="competencias" class="text-lg font-medium uppercase tracking-widest">Competências</h2>
      <dl class="mt-4 grid gap-x-8 gap-y-4 sm:grid-cols-2">
        {cv.skills.map((s) => (
          <div class="border-t border-[var(--fg)]/15 pt-3 print:break-inside-avoid">
            <dt class="text-xs uppercase tracking-widest text-[var(--fg)]/60">{s.group}</dt>
            <dd class="mt-1 font-light leading-relaxed text-[var(--fg)]/85">{s.items.join(' · ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-12" aria-labelledby="projetos">
      <h2 id="projetos" class="text-lg font-medium uppercase tracking-widest">Projetos</h2>
      <div class="mt-4 flex flex-col gap-5">
        {cv.families.map((f) => (
          <div class="border-t border-[var(--fg)]/15 pt-4 print:break-inside-avoid">
            <h3 class="font-mono text-xs uppercase tracking-widest text-[var(--fg)]/60">{f.name}</h3>
            <ul class="mt-2 flex flex-col gap-1 font-light leading-relaxed text-[var(--fg)]/85">
              {f.repos.map((r) => <li><a class="font-medium text-[var(--fg)] underline decoration-[var(--fg)]/30 hover:opacity-70" href={r.url}>{r.name}</a> — {r.text}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
<style>
  @media print {
    .hero-heading { background: none; -webkit-text-fill-color: #000; }
    main, main :global(*) { color: #000; }
  }
</style>
